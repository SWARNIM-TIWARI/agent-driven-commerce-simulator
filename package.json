{
  "name": "commerce-wind-tunnel",
  "version": "0.1.0",
  "description": "An experimental environment for autonomous commerce agents running on PayPal infrastructure",
  "scripts": {
    "dev":             "next dev",
    "build":           "next build",
    "start":           "next start",
    "simulate":        "tsx src/cli/simulate.ts",
