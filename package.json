    "db:generate":     "prisma generate"
  },
  "dependencies": {
    "next":            "^15.0.0",
    "react":           "^18.3.0",
    "react-dom":       "^18.3.0",
    "@prisma/client":  "^5.20.0",
    "openai":          "^4.67.0"
  },
  "devDependencies": {
    "@types/node":       "^20.12.0",
    "@types/react":      "^18.3.0",
    "@types/react-dom":  "^18.3.0",
    "prisma":            "^5.20.0",
    "tsx":               "^4.7.1",
    "typescript":        "^5.4.3",
    "vitest":            "^1.4.0"
  }
}